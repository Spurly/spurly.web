VITE_API_URL=http://localhost:5000
VITE_API_BASE=/api
VITE_LINKEDIN_CLIENT_ID=your_linkedin_app_id_here

# Cashfree checkout mode: 'sandbox' (default) or 'production'.
# Leave unset in local dev. Production builds MUST set this to
# 'production' or checkout opens the sandbox widget against live orders.
VITE_CASHFREE_ENV=sandbox

# logo.dev PUBLISHABLE key — builds company logo image URLs (img.logo.dev).
# Safe to ship in client bundles; it is not the backend's secret search key.
# Unset = every company falls back to its tinted initial, which is fine.
VITE_LOGO_DEV_TOKEN=pk_your_publishable_key_here
