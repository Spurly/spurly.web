# Loaded automatically by `vite build` (production mode), overriding .env.
# The web app on app.getspurly.com talks to the API on api.getspurly.com.
VITE_API_URL=https://api.getspurly.com
VITE_API_BASE=/api

# Cashfree checkout mode. MUST be 'production' here: cashfreeSdk.js
# defaults to sandbox when this is unset, which would open the sandbox
# checkout widget against live backend orders and fail every payment.
VITE_CASHFREE_ENV=production

# logo.dev PUBLISHABLE key — builds company logo image URLs (img.logo.dev).
# Public by design: it is embedded in every <img> src the table renders, works
# only against img.logo.dev, and is NOT the backend's secret search key.
# Vite inlines this at BUILD time, so it must exist wherever the build runs —
# committed here rather than set in Vercel's dashboard so a fresh clone and CI
# both produce a working build with no manual step to forget.
# Unset, every company falls back to its tinted initial.
VITE_LOGO_DEV_TOKEN=pk_bgenU1z5SaC77Erd9d1v1w
