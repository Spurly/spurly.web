{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/developers/v2", "destination": "/developers", "permanent": true },
    { "source": "/developers/v2/:path*", "destination": "/developers/:path*", "permanent": true },
    { "source": "/developers/webhook-events", "destination": "/developers/webhooks", "permanent": true },
    { "source": "/developers/authentication", "destination": "/developers/quickstart", "permanent": true },
    { "source": "/developers/pagination", "destination": "/developers/limits", "permanent": true },
    { "source": "/developers/openapi.json", "destination": "/developers/openapi.v2.json", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(dashboard|hub|admin|onboarding|subscribe|signup|login|forgot-password|reset-password|oauth|partner|dev)(/.*)?",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/oauth/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/login/org/enter",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/partner/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
